{
  "name": "@tallio/contentful-mock",
  "version": "0.1.0",
  "description": "In-memory mock for Contentful Delivery and Management API clients",
  "author": "Teun Verhaert",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write src tests"
  },
  "peerDependencies": {
    "contentful": ">=11",
    "contentful-management": ">=11"
  },
  "peerDependenciesMeta": {
    "contentful": {
      "optional": true
    },
    "contentful-management": {
      "optional": true
    }
  },
  "dependencies": {
    "fast-json-patch": "^3.1.1",
    "fuse.js": "^7.0.0",
    "geolib": "^3.3.4",
    "seedrandom": "^3.0.5",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/seedrandom": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "contentful": "^11.12.10",
    "contentful-management": "^12.20.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
